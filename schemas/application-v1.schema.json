{
  "$defs": {
    "AiPolicyView": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "revision",
        "enabled"
      ],
      "type": "object"
    },
    "AppError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "retryable": {
          "type": "boolean"
        },
        "safe_message": {
          "$ref": "#/$defs/SafeMessage"
        }
      },
      "required": [
        "code",
        "safe_message",
        "retryable"
      ],
      "type": "object"
    },
    "ApplicationResult": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "status",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/HostStatus"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "doctor",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/DoctorReport"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "probe_runtime",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/RuntimeProbeReport"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "ai_policy",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/AiPolicyView"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "probe_consent",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/ProbeConsentReceipt"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "shutdown",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/ShutdownReceipt"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "capture",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/CaptureOutcome"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "asset_chunk",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/LibraryAssetChunk"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "record_metadata",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/RecordMetadata"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "records_page",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/LibraryRecordsPage"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "import_report",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/ImportReport"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "export_receipt",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/ExportReceipt"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "AssetId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "BridgeState": {
      "enum": [
        "stopped",
        "starting",
        "ready",
        "degraded",
        "unavailable"
      ],
      "type": "string"
    },
    "BuildId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "type": "string"
    },
    "CancelReason": {
      "description": "S02 §5.2: why a capture ended without an accepted frame.",
      "enum": [
        "escape",
        "empty_selection",
        "explicit_request",
        "client_disconnected"
      ],
      "type": "string"
    },
    "CaptureOutcome": {
      "description": "S02 §5.2: terminal outcome of one `capture.command`.",
      "oneOf": [
        {
          "properties": {
            "receipt": {
              "$ref": "#/$defs/CaptureReceipt"
            },
            "status": {
              "const": "saved",
              "type": "string"
            }
          },
          "required": [
            "status",
            "receipt"
          ],
          "type": "object"
        },
        {
          "properties": {
            "operation_id": {
              "$ref": "#/$defs/OperationId"
            },
            "reason": {
              "$ref": "#/$defs/CancelReason"
            },
            "status": {
              "const": "cancelled",
              "type": "string"
            }
          },
          "required": [
            "status",
            "operation_id",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "CaptureReceipt": {
      "additionalProperties": false,
      "description": "S02 §5.2/§11.5: receipt of one committed capture. No pixels and no absolute path.",
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/AssetId"
        },
        "byte_size": {
          "description": "Decimal string: a byte count must not round through a JavaScript number.",
          "type": "string"
        },
        "canonical_mime": {
          "type": "string"
        },
        "canonical_sha256": {
          "type": "string"
        },
        "height": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "operation_id": {
          "$ref": "#/$defs/OperationId"
        },
        "record_id": {
          "$ref": "#/$defs/RecordId"
        },
        "relative_path": {
          "description": "Library-relative canonical path (`assets/...`), never an absolute path.",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "width": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "operation_id",
        "record_id",
        "asset_id",
        "canonical_mime",
        "canonical_sha256",
        "width",
        "height",
        "byte_size",
        "relative_path",
        "warnings"
      ],
      "type": "object"
    },
    "CheckId": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "type": "string"
    },
    "CheckOutcome": {
      "enum": [
        "PASSED",
        "FAILED",
        "BLOCKED",
        "NOT_RUN",
        "UNSUPPORTED"
      ],
      "type": "string"
    },
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "$ref": "#/$defs/CheckId"
        },
        "duration_ms": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "evidence_id": {
          "$ref": "#/$defs/EvidenceId"
        },
        "outcome": {
          "$ref": "#/$defs/CheckOutcome"
        },
        "safe_code": {
          "$ref": "#/$defs/ErrorCode"
        }
      },
      "required": [
        "check_id",
        "outcome"
      ],
      "type": "object"
    },
    "ConsentId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "DoctorReport": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckResult"
          },
          "type": "array"
        },
        "host": {
          "$ref": "#/$defs/HostStatus"
        },
        "report_id": {
          "$ref": "#/$defs/ReportId"
        }
      },
      "required": [
        "report_id",
        "host",
        "checks"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "description": "Fixed public registry. Never expose provider exception strings in `safe_message`.",
      "oneOf": [
        {
          "enum": [
            "METHOD_NOT_SUPPORTED",
            "INVALID_REQUEST",
            "FRAME_TOO_LARGE",
            "PROTOCOL_TRUNCATED_FRAME",
            "PERMISSION_DENIED",
            "LIBRARY_MISMATCH",
            "PROTOCOL_MISMATCH",
            "HOST_ALREADY_RUNNING",
            "SCHEMA_INCOMPATIBLE",
            "CREDENTIAL_STORE_UNAVAILABLE",
            "RUNTIME_UNAVAILABLE",
            "MODEL_NOT_INSTALLED",
            "AI_DISABLED",
            "MODEL_CONFIG_UNSUPPORTED",
            "BRIDGE_UNAVAILABLE",
            "WAIT_TIMEOUT",
            "CAPTURE_BACKPRESSURE",
            "CAPTURE_TARGET_LOST",
            "CAPTURE_TOPOLOGY_CHANGED",
            "CAPTURE_FOCUS_UNAVAILABLE",
            "CAPTURE_UNAVAILABLE",
            "CAPTURE_GDI_FAILED",
            "IMAGE_LIMIT_EXCEEDED",
            "CANONICAL_SIZE_UNSUPPORTED",
            "ASSET_INTEGRITY_FAILED",
            "ASSET_NOT_FOUND",
            "STORAGE_FULL"
          ],
          "type": "string"
        },
        {
          "const": "CAPTURE_BUSY",
          "description": "S02 §5.6: capture vocabulary. Every value is produced by the real capture/library\npath; none of them is a placeholder for an unimplemented capability.",
          "type": "string"
        },
        {
          "const": "CODEC_FAILED",
          "description": "S02: the bundled codec refused to encode or decode the accepted image.",
          "type": "string"
        },
        {
          "const": "IMAGE_INPUT_INVALID",
          "description": "S02: the pixel buffer handed to the codec was not a usable image.",
          "type": "string"
        }
      ]
    },
    "EvidenceId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "ExportAppliedParameters": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "$ref": "#/$defs/ExportFormat"
        },
        "jpeg_background": {
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": [
            "array",
            "null"
          ]
        },
        "max_side": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "private_metadata_stripped": {
          "type": "boolean"
        },
        "quality": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "resize_applied": {
          "type": "boolean"
        }
      },
      "required": [
        "format",
        "resize_applied",
        "private_metadata_stripped"
      ],
      "type": "object"
    },
    "ExportExistence": {
      "enum": [
        "verified",
        "not_checked"
      ],
      "type": "string"
    },
    "ExportFormat": {
      "enum": [
        "png",
        "jpeg",
        "webp",
        "avif"
      ],
      "type": "string"
    },
    "ExportReceipt": {
      "additionalProperties": false,
      "properties": {
        "applied_parameters": {
          "$ref": "#/$defs/ExportAppliedParameters"
        },
        "byte_size": {
          "type": "string"
        },
        "encoding_profile_fingerprint": {
          "type": "string"
        },
        "existence": {
          "$ref": "#/$defs/ExportExistence"
        },
        "expires_at_epoch_seconds": {
          "type": [
            "string",
            "null"
          ]
        },
        "export_path": {
          "type": "string"
        },
        "height": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "mime": {
          "type": "string"
        },
        "operation_id": {
          "$ref": "#/$defs/OperationId"
        },
        "partial": {
          "type": "boolean"
        },
        "sha256": {
          "type": "string"
        },
        "sidecar": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExportSidecar"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_asset_id": {
          "$ref": "#/$defs/AssetId"
        },
        "width": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "operation_id",
        "source_asset_id",
        "export_path",
        "mime",
        "width",
        "height",
        "byte_size",
        "sha256",
        "partial",
        "existence",
        "encoding_profile_fingerprint",
        "applied_parameters"
      ],
      "type": "object"
    },
    "ExportSidecar": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "type": "string"
        },
        "export_path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "export_path",
        "sha256",
        "byte_size"
      ],
      "type": "object"
    },
    "HostInstanceId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "HostState": {
      "enum": [
        "starting",
        "ready",
        "degraded",
        "stopping"
      ],
      "type": "string"
    },
    "HostStatus": {
      "additionalProperties": false,
      "properties": {
        "ai_enabled": {
          "type": "boolean"
        },
        "available_methods": {
          "items": {
            "$ref": "#/$defs/MethodName"
          },
          "type": "array"
        },
        "bridge_state": {
          "$ref": "#/$defs/BridgeState"
        },
        "build_id": {
          "$ref": "#/$defs/BuildId"
        },
        "host_instance_id": {
          "$ref": "#/$defs/HostInstanceId"
        },
        "library_id": {
          "$ref": "#/$defs/LibraryId"
        },
        "protocol": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/HostState"
        }
      },
      "required": [
        "host_instance_id",
        "library_id",
        "build_id",
        "protocol",
        "state",
        "schema_version",
        "ai_enabled",
        "bridge_state",
        "available_methods"
      ],
      "type": "object"
    },
    "ImportBatchId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "ImportBatchState": {
      "enum": [
        "running",
        "pausing",
        "paused",
        "cancelling",
        "cancelled",
        "needs_attention",
        "completed",
        "completed_with_errors"
      ],
      "type": "string"
    },
    "ImportItemId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "ImportItemReport": {
      "additionalProperties": false,
      "properties": {
        "durable_input": {
          "type": "boolean"
        },
        "item_id": {
          "$ref": "#/$defs/ImportItemId"
        },
        "ordinal": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImportReceipt"
            },
            {
              "type": "null"
            }
          ]
        },
        "safe_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/ImportState"
        }
      },
      "required": [
        "item_id",
        "ordinal",
        "state",
        "durable_input"
      ],
      "type": "object"
    },
    "ImportReceipt": {
      "additionalProperties": false,
      "properties": {
        "canonical_mime": {
          "type": "string"
        },
        "canonical_sha256": {
          "type": "string"
        },
        "current_asset_id": {
          "$ref": "#/$defs/AssetId"
        },
        "height": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "operation_id": {
          "$ref": "#/$defs/OperationId"
        },
        "origin_id": {
          "$ref": "#/$defs/OriginId"
        },
        "original_asset_id": {
          "$ref": "#/$defs/AssetId"
        },
        "record_id": {
          "$ref": "#/$defs/RecordId"
        },
        "relative_path": {
          "type": "string"
        },
        "requested_profile_used": {
          "type": "boolean"
        },
        "width": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "operation_id",
        "record_id",
        "original_asset_id",
        "current_asset_id",
        "origin_id",
        "canonical_mime",
        "canonical_sha256",
        "relative_path",
        "width",
        "height",
        "requested_profile_used"
      ],
      "type": "object"
    },
    "ImportReport": {
      "additionalProperties": false,
      "properties": {
        "active_work": {
          "type": "boolean"
        },
        "batch_id": {
          "$ref": "#/$defs/ImportBatchId"
        },
        "cancelled_unaccepted": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "control": {
          "type": "string"
        },
        "directory_issues": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "discovered": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "discovery_abandoned": {
          "type": "boolean"
        },
        "discovery_complete": {
          "type": "boolean"
        },
        "discovery_limit": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "discovery_limit_hit": {
          "type": "boolean"
        },
        "failed": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "held": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "in_flight": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/ImportItemReport"
          },
          "type": "array"
        },
        "linked_existing": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "next_ordinal": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "retained_input": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "saved_new": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "skipped": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/ImportBatchState"
        }
      },
      "required": [
        "batch_id",
        "revision",
        "control",
        "state",
        "active_work",
        "discovery_complete",
        "discovery_abandoned",
        "discovery_limit",
        "discovery_limit_hit",
        "directory_issues",
        "discovered",
        "saved_new",
        "linked_existing",
        "skipped",
        "failed",
        "held",
        "cancelled_unaccepted",
        "in_flight",
        "retained_input",
        "items"
      ],
      "type": "object"
    },
    "ImportState": {
      "enum": [
        "discovered",
        "processing",
        "held",
        "recoverable",
        "saved_new",
        "linked_existing",
        "skipped",
        "cancelled_unaccepted"
      ],
      "type": "string"
    },
    "LibraryAssetChunk": {
      "additionalProperties": false,
      "description": "One bounded image transfer chunk. `library.asset.read` carries canonical bytes;\n`library.asset.preview` carries a bounded immutable WebP derivative (which may\ndiffer from the canonical). Digest/MIME/size describe that transfer, never a URL.\n`data_hex` keeps the frame printable without a base64 dependency.",
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/AssetId"
        },
        "data_hex": {
          "pattern": "^([0-9a-f]{2})*$",
          "type": "string"
        },
        "eof": {
          "type": "boolean"
        },
        "mime": {
          "type": "string"
        },
        "next_offset": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "offset": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "sha256": {
          "type": "string"
        },
        "total_size": {
          "description": "Decimal string of the complete transfer payload size.",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "offset",
        "next_offset",
        "eof",
        "total_size",
        "sha256",
        "mime",
        "data_hex"
      ],
      "type": "object"
    },
    "LibraryId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "LibraryRecordEntry": {
      "additionalProperties": false,
      "description": "S02 §10.3: one entry in a library records page; asset paths are library-relative.",
      "properties": {
        "byte_size": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "height": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/RecordId"
        },
        "preview_asset_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetId"
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "width": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "created_at",
        "title",
        "target",
        "width",
        "height",
        "byte_size"
      ],
      "type": "object"
    },
    "LibraryRecordsPage": {
      "additionalProperties": false,
      "description": "S02 §10.3: one bounded page of committed records; `next_cursor` is opaque.",
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/LibraryRecordEntry"
          },
          "type": "array"
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items"
      ],
      "type": "object"
    },
    "MethodName": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "type": "string"
    },
    "OperationId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "OriginId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "ProbeConsentReceipt": {
      "additionalProperties": false,
      "properties": {
        "consent_id": {
          "$ref": "#/$defs/ConsentId"
        },
        "expires_at": {
          "$ref": "#/$defs/UtcTime"
        },
        "policy_revision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "consent_id",
        "expires_at",
        "policy_revision"
      ],
      "type": "object"
    },
    "ProtocolVersion": {
      "additionalProperties": false,
      "properties": {
        "major": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "minor": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "major",
        "minor"
      ],
      "type": "object"
    },
    "RecordId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "RecordMetadata": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "$ref": "#/$defs/RecordId"
        },
        "source_kind": {
          "type": "string"
        },
        "source_reports": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "record_id",
        "source_kind",
        "source_reports"
      ],
      "type": "object"
    },
    "ReportId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "RequestEnvelope": {
      "additionalProperties": false,
      "description": "Decoded after the authorized handshake; `params` never carries a trusted context.",
      "properties": {
        "library_id": {
          "$ref": "#/$defs/LibraryId"
        },
        "method": {
          "$ref": "#/$defs/MethodName"
        },
        "params": true,
        "protocol": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "timeout_ms": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "protocol",
        "request_id",
        "library_id",
        "method",
        "timeout_ms",
        "params"
      ],
      "type": "object"
    },
    "RequestId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "Response": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "result",
              "type": "string"
            },
            "request_id": {
              "$ref": "#/$defs/RequestId"
            },
            "result": {
              "$ref": "#/$defs/ApplicationResult"
            }
          },
          "required": [
            "kind",
            "request_id",
            "result"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "error": {
              "$ref": "#/$defs/AppError"
            },
            "kind": {
              "const": "error",
              "type": "string"
            },
            "request_id": {
              "$ref": "#/$defs/RequestId"
            }
          },
          "required": [
            "kind",
            "request_id",
            "error"
          ],
          "type": "object"
        }
      ]
    },
    "Revision": {
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$",
      "type": "string"
    },
    "RuntimeProbeReport": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckResult"
          },
          "type": "array"
        },
        "compatibility_evidence_id": {
          "$ref": "#/$defs/EvidenceId"
        },
        "probe_id": {
          "$ref": "#/$defs/ReportId"
        }
      },
      "required": [
        "probe_id",
        "checks",
        "compatibility_evidence_id"
      ],
      "type": "object"
    },
    "SafeMessage": {
      "maxLength": 512,
      "minLength": 1,
      "not": {
        "pattern": "[\\u0000-\\u001F\\u007F-\\u009F]"
      },
      "type": "string"
    },
    "ShutdownReceipt": {
      "additionalProperties": false,
      "properties": {
        "host_instance_id": {
          "$ref": "#/$defs/HostInstanceId"
        },
        "state": {
          "$ref": "#/$defs/HostState"
        }
      },
      "required": [
        "host_instance_id",
        "state"
      ],
      "type": "object"
    },
    "UtcTime": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/RequestEnvelope"
    },
    {
      "$ref": "#/$defs/Response"
    }
  ],
  "title": "ApplicationFrame"
}
