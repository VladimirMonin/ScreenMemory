{
  "$defs": {
    "AiPolicyPatch": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "expected_revision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "expected_revision",
        "enabled"
      ],
      "type": "object"
    },
    "AssetId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "AuthorizeProbeRequest": {
      "additionalProperties": false,
      "properties": {
        "allow_load": {
          "type": "boolean"
        },
        "fixture": {
          "$ref": "#/$defs/ProbeFixture"
        },
        "lifetime_seconds": {
          "$ref": "#/$defs/ConsentLifetime"
        },
        "profile_id": {
          "$ref": "#/$defs/ProfileId"
        }
      },
      "required": [
        "fixture",
        "profile_id",
        "allow_load",
        "lifetime_seconds"
      ],
      "type": "object"
    },
    "CanonicalProfile": {
      "enum": [
        "webp_exact",
        "avif_sdr90"
      ],
      "type": "string"
    },
    "CaptureCommandParams": {
      "additionalProperties": false,
      "description": "S02 §5.2: parameters of `capture.command`.\n\nThe initiator is deliberately absent: a client cannot declare itself a native hotkey.\nThe trusted host adapter records the trigger out of band.",
      "properties": {
        "mode": {
          "$ref": "#/$defs/CaptureMode"
        },
        "operation_id": {
          "$ref": "#/$defs/OperationId"
        }
      },
      "required": [
        "operation_id",
        "mode"
      ],
      "type": "object"
    },
    "CaptureMode": {
      "description": "S02 §3.1: closed vocabulary of one capture target.",
      "enum": [
        "region",
        "window",
        "monitor",
        "desktop"
      ],
      "type": "string"
    },
    "ConsentId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "ConsentLifetime": {
      "maximum": 300,
      "minimum": 1,
      "type": "integer"
    },
    "DoctorRequest": {
      "additionalProperties": false,
      "properties": {
        "include_runtime_inventory": {
          "type": "boolean"
        }
      },
      "required": [
        "include_runtime_inventory"
      ],
      "type": "object"
    },
    "DuplicatePolicy": {
      "enum": [
        "reuse_record",
        "keep_both"
      ],
      "type": "string"
    },
    "EmptyParams": {
      "additionalProperties": false,
      "type": "object"
    },
    "ExportFormat": {
      "enum": [
        "png",
        "jpeg",
        "webp",
        "avif"
      ],
      "type": "string"
    },
    "ExportMetadataPolicy": {
      "enum": [
        "strip_private",
        "include_source_sidecar"
      ],
      "type": "string"
    },
    "ExportRequest": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetId"
            },
            {
              "type": "null"
            }
          ],
          "description": "None resolves Current exactly once. Replay never resolves again."
        },
        "destination_path": {
          "description": "None selects the host-managed export registry (TTL 24h), never a wire cache path.",
          "type": [
            "string",
            "null"
          ]
        },
        "format": {
          "$ref": "#/$defs/ExportFormat"
        },
        "jpeg_background": {
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": [
            "array",
            "null"
          ]
        },
        "max_side": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "metadata_policy": {
          "$ref": "#/$defs/ExportMetadataPolicy"
        },
        "operation_id": {
          "$ref": "#/$defs/OperationId"
        },
        "record_id": {
          "$ref": "#/$defs/RecordId"
        }
      },
      "required": [
        "operation_id",
        "record_id",
        "format",
        "metadata_policy"
      ],
      "type": "object"
    },
    "ImportBatchId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "ImportBatchRequest": {
      "additionalProperties": false,
      "properties": {
        "batch_id": {
          "$ref": "#/$defs/ImportBatchId"
        }
      },
      "required": [
        "batch_id"
      ],
      "type": "object"
    },
    "ImportControl": {
      "enum": [
        "pause",
        "cancel_processing",
        "resume",
        "retry"
      ],
      "type": "string"
    },
    "ImportControlRequest": {
      "additionalProperties": false,
      "properties": {
        "batch_id": {
          "$ref": "#/$defs/ImportBatchId"
        },
        "control": {
          "$ref": "#/$defs/ImportControl"
        }
      },
      "required": [
        "batch_id",
        "control"
      ],
      "type": "object"
    },
    "ImportReportPageRequest": {
      "additionalProperties": false,
      "properties": {
        "after_ordinal": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "batch_id": {
          "$ref": "#/$defs/ImportBatchId"
        }
      },
      "required": [
        "batch_id",
        "after_ordinal"
      ],
      "type": "object"
    },
    "ImportRequest": {
      "additionalProperties": false,
      "properties": {
        "batch_id": {
          "$ref": "#/$defs/ImportBatchId"
        },
        "duplicates": {
          "$ref": "#/$defs/DuplicatePolicy"
        },
        "profile": {
          "$ref": "#/$defs/CanonicalProfile"
        },
        "source_paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "batch_id",
        "source_paths",
        "profile",
        "duplicates"
      ],
      "type": "object"
    },
    "LibraryAssetRequest": {
      "additionalProperties": false,
      "description": "S02 §10.1: bounded read of one committed canonical asset.",
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/AssetId"
        },
        "offset": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "asset_id",
        "offset"
      ],
      "type": "object"
    },
    "LibraryRecordsRequest": {
      "additionalProperties": false,
      "description": "S02 §10.3: one bounded page of committed library records.",
      "properties": {
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "limit"
      ],
      "type": "object"
    },
    "OperationId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "ProbeFixture": {
      "enum": [
        "synthetic_menu_v1",
        "embedding_text_v1"
      ],
      "type": "string"
    },
    "ProfileId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "type": "string"
    },
    "RecordId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "RecordMetadataRequest": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "$ref": "#/$defs/RecordId"
        }
      },
      "required": [
        "record_id"
      ],
      "type": "object"
    },
    "Revision": {
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$",
      "type": "string"
    },
    "RuntimeProbeRequest": {
      "additionalProperties": false,
      "properties": {
        "allow_model_load": {
          "type": "boolean"
        },
        "consent_id": {
          "$ref": "#/$defs/ConsentId"
        },
        "fixture": {
          "$ref": "#/$defs/ProbeFixture"
        },
        "profile_id": {
          "$ref": "#/$defs/ProfileId"
        }
      },
      "required": [
        "fixture",
        "profile_id",
        "allow_model_load",
        "consent_id"
      ],
      "type": "object"
    }
  },
