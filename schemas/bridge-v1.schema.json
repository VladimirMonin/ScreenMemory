{
  "$defs": {
    "BridgeError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/BridgeErrorCode"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "retryable"
      ],
      "type": "object"
    },
    "BridgeErrorCode": {
      "enum": [
        "UNAVAILABLE",
        "UNSUPPORTED",
        "MODEL_NOT_INSTALLED",
        "MODEL_CONFIG_UNSUPPORTED",
        "WAIT_TIMEOUT"
      ],
      "type": "string"
    },
    "BridgeProbeRequest": {
      "additionalProperties": false,
      "properties": {
        "allow_model_load": {
          "type": "boolean"
        },
        "fixture": {
          "$ref": "#/$defs/ProbeFixture"
        },
        "profile_id": {
          "$ref": "#/$defs/ProfileId"
        },
        "protocol": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        }
      },
      "required": [
        "protocol",
        "request_id",
        "fixture",
        "profile_id",
        "allow_model_load"
      ],
      "type": "object"
    },
    "BridgeResponse": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "checks": {
              "items": {
                "$ref": "#/$defs/CheckResult"
              },
              "type": "array"
            },
            "kind": {
              "const": "result",
              "type": "string"
            },
            "request_id": {
              "$ref": "#/$defs/RequestId"
            }
          },
          "required": [
            "kind",
            "request_id",
            "checks"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "error": {
              "$ref": "#/$defs/BridgeError"
            },
            "kind": {
              "const": "error",
              "type": "string"
            },
            "request_id": {
              "$ref": "#/$defs/RequestId"
            }
          },
          "required": [
            "kind",
            "request_id",
            "error"
          ],
          "type": "object"
        }
      ]
    },
    "CheckId": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "type": "string"
    },
    "CheckOutcome": {
      "enum": [
        "PASSED",
        "FAILED",
        "BLOCKED",
        "NOT_RUN",
        "UNSUPPORTED"
      ],
      "type": "string"
    },
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "$ref": "#/$defs/CheckId"
        },
        "duration_ms": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "evidence_id": {
          "$ref": "#/$defs/EvidenceId"
        },
        "outcome": {
          "$ref": "#/$defs/CheckOutcome"
        },
        "safe_code": {
          "$ref": "#/$defs/ErrorCode"
        }
      },
      "required": [
        "check_id",
        "outcome"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "description": "Fixed public registry. Never expose provider exception strings in `safe_message`.",
      "oneOf": [
        {
          "enum": [
            "METHOD_NOT_SUPPORTED",
            "INVALID_REQUEST",
            "FRAME_TOO_LARGE",
            "PROTOCOL_TRUNCATED_FRAME",
            "PERMISSION_DENIED",
            "LIBRARY_MISMATCH",
            "PROTOCOL_MISMATCH",
            "HOST_ALREADY_RUNNING",
            "SCHEMA_INCOMPATIBLE",
            "CREDENTIAL_STORE_UNAVAILABLE",
            "RUNTIME_UNAVAILABLE",
            "MODEL_NOT_INSTALLED",
            "AI_DISABLED",
            "MODEL_CONFIG_UNSUPPORTED",
            "BRIDGE_UNAVAILABLE",
            "WAIT_TIMEOUT",
            "CAPTURE_BACKPRESSURE",
            "CAPTURE_TARGET_LOST",
            "CAPTURE_TOPOLOGY_CHANGED",
            "CAPTURE_FOCUS_UNAVAILABLE",
            "CAPTURE_UNAVAILABLE",
            "CAPTURE_GDI_FAILED",
            "IMAGE_LIMIT_EXCEEDED",
            "CANONICAL_SIZE_UNSUPPORTED",
            "ASSET_INTEGRITY_FAILED",
            "ASSET_NOT_FOUND",
            "STORAGE_FULL"
          ],
          "type": "string"
        },
        {
          "const": "CAPTURE_BUSY",
          "description": "S02 §5.6: capture vocabulary. Every value is produced by the real capture/library\npath; none of them is a placeholder for an unimplemented capability.",
          "type": "string"
        },
        {
          "const": "CODEC_FAILED",
          "description": "S02: the bundled codec refused to encode or decode the accepted image.",
          "type": "string"
        },
        {
          "const": "IMAGE_INPUT_INVALID",
          "description": "S02: the pixel buffer handed to the codec was not a usable image.",
          "type": "string"
        }
      ]
    },
    "EvidenceId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "ProbeFixture": {
      "enum": [
        "synthetic_menu_v1",
        "embedding_text_v1"
      ],
      "type": "string"
    },
    "ProfileId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "type": "string"
    },
    "ProtocolVersion": {
      "additionalProperties": false,
      "properties": {
        "major": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "minor": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "major",
        "minor"
      ],
      "type": "object"
    },
    "RequestId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/BridgeProbeRequest"
    },
    {
      "$ref": "#/$defs/BridgeResponse"
    }
  ],
  "title": "BridgeFrame"
}
